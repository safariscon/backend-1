NODE_ENV=production
PORT=10000
MONGODB_URI=your_mongodb_connection_string
MONGODB_STORAGE_LIMIT_MB=512
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=1d
JWT_ACCESS_TTL_SECONDS=7200
JWT_REFRESH_TTL_SECONDS=86400
AUTH_OTP_EXPIRY_MINUTES=10
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password
CORS_ORIGINS=https://safariscon.vercel.app,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CLIENT_URL=http://localhost:5173
FLUTTER_WEB_URL=http://localhost:5174
FRONTEND_URL=https://safariscon.vercel.app
PUBLIC_FRONTEND_URL=https://safariscon.vercel.app
PUBLIC_API_URL=https://umuhuzaback.onrender.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=safariservconn
CLOUDINARY_STORAGE_LIMIT_GB=25
CLOUDINARY_BANDWIDTH_LIMIT_GB=25
PLATFORM_COMMISSION_RATE=0.12

# XentriPay merchant credentials (platform wallet that collects customer payments)
# Get the API key from the XentriPay merchant dashboard. Never expose it to the frontend.
XENTRIPAY_ENV=test
XENTRIPAY_API_KEY=your_xentripay_api_key
XENTRIPAY_BASE_URL=https://merchant.test.xentripay.com
XENTRIPAY_CURRENCY=RWF
XENTRIPAY_MIN_AMOUNT=100
XENTRIPAY_CHARGES_INCLUDED=true
XENTRIPAY_MERCHANT_NAME=SafarisCon
XENTRIPAY_MERCHANT_EMAIL=payments@example.com
XENTRIPAY_MERCHANT_PHONE=0780000000
XENTRIPAY_COLLECTION_REDIRECT_URL=https://your-frontend.example/payments/callback
XENTRIPAY_COLLECTION_RETURN_URL=https://your-frontend.example/payments/return
XENTRIPAY_CHECKOUT_FINAL_URL=https://your-frontend.example/payments/result
# Set true only in local/dev when no live XentriPay key is available.
XENTRIPAY_SIMULATE_SUCCESS=false

MAILER_HOST=
MAILER_PORT=
MAILER_PRODUCER_EMAIL=
MAILER_PRODUCER_PASSWORD=
MAILER_REJECT_UNAUTHORIZED=
